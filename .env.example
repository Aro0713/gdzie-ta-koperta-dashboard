# ==============================================================================
# Gdzie Ta Koperta - Zmienne Środowiskowe (.env.example)
# Skopiuj ten plik jako .env.local i uzupełnij wartości przed uruchomieniem projektu.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Baza Danych: Neon PostgreSQL + PostGIS (Wymagane)
# ------------------------------------------------------------------------------
# Połączenie pooled (do codziennych zapytań API):
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Połączenie direct unpooled (opcjonalne, zalecane do migracji i skryptów ETL):
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Przechowywanie zdjęć kopert: Cloudinary CDN (Wymagane do modułu zgłoszeń)
# Załóż darmowe konto na cloudinary.com i pobierz klucze z Dashboardu.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="twoj-cloud-name"
CLOUDINARY_API_KEY="twoj-api-key"
CLOUDINARY_API_SECRET="twoj-api-secret"

# ------------------------------------------------------------------------------
# 3. Panel Moderatora i Administratora (/admin)
# ------------------------------------------------------------------------------
# Hasło awaryjne do panelu moderatora (wygeneruj silny, losowy ciąg min. 32 znaków):
ADMIN_SECRET="wygeneruj-silny-losowy-klucz-min-32-znaki"

# Dozwoleni użytkownicy OpenStreetMap z uprawnieniami moderatora (oddzieleni przecinkami):
ADMIN_OSM_USERS="Aro0713,808sBartye"

# ------------------------------------------------------------------------------
# 4. Adresy domen i subdomen (Next.js Multi-domain Routing)
# ------------------------------------------------------------------------------
# Adres aplikacji mapowej PWA (subdomena produkcyjna):
NEXT_PUBLIC_APP_URL="https://app.gdzietakoperta.pl"

# Adres strony głównej / informacyjnej (domena nadrzędna):
NEXT_PUBLIC_MAIN_URL="https://gdzietakoperta.pl"

# ------------------------------------------------------------------------------
# 5. Kafelki mapy Leaflet (Opcjonalne - domyślnie OpenStreetMap Standard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# ------------------------------------------------------------------------------
# 6. Integracja OpenStreetMap OAuth 2.0 (Opcjonalne - do logowania przez OSM)
# ------------------------------------------------------------------------------
# OSM_OAUTH_CLIENT_ID=""
# OSM_OAUTH_CLIENT_SECRET=""
# OSM_SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 7. Klucz do wymuszenia odświeżenia pamięci podręcznej (Opcjonalne)
# ------------------------------------------------------------------------------
# REVALIDATE_SECRET="tajny-klucz-revalidacji"
